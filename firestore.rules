rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allowed preset avatar names
    function isValidPreset(preset) {
      return preset in ['aditya', 'meera', 'kabir', 'zoya', 'rohan', 'tara', 'ishaan', 'anya'];
    }

    // Allowed accessory IDs
    function isValidAccessory(acc) {
      return acc == null || acc in ['beanie', 'crown', 'headphones', 'wizard_hat', 'flower_crown', 'cat_ears', 'grad_cap'];
    }

    // Allowed library theme IDs
    function isValidTheme(theme) {
      return theme in ['classic', 'vampire', 'renaissance', 'midnight', 'cherry', 'space', 'cafe', 'greathall'];
    }

    // Valid lowercase alphanumeric username (1-16 chars)
    function isValidUsername(name) {
      return name is string && name.size() >= 1 && name.size() <= 16 && name.matches('^[a-z0-9_]+$');
    }

    // User Profile Document
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null 
                            && request.auth.uid == uid
                            && isValidUsername(request.resource.data.username)
                            && isValidPreset(request.resource.data.preset)
                            && (!('accessory' in request.resource.data) || isValidAccessory(request.resource.data.accessory));
      allow delete: if false;

      // User's recent rooms subcollection
      match /recentRooms/{code} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // User's session goals subcollection
      match /goals/{goalId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null 
                      && request.auth.uid == uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 60
                      && request.resource.data.status in ['done', 'missed'];
        allow update, delete: if false;
      }

      // User's daily activity heatmap subcollection
      match /days/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null 
                     && request.auth.uid == uid
                     && request.resource.data.pomodoros is number
                     && request.resource.data.pomodoros >= 0
                     && request.resource.data.minutes is number
                     && request.resource.data.minutes >= 0;
      }
    }

    // Unique Username Registry
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid
                    && isValidUsername(name);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Study Rooms
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.ownerUid == request.auth.uid
                    && code.size() == 6
                    && code.matches('^[A-Z0-9]+$')
                    && (!('theme' in request.resource.data) || isValidTheme(request.resource.data.theme));
      allow update: if request.auth != null 
                    && resource.data.ownerUid == request.auth.uid
                    && (!('theme' in request.resource.data) || isValidTheme(request.resource.data.theme));
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Room weekly leaderboard members
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null 
                     && request.auth.uid == uid
                     && request.resource.data.weekKey is string
                     && request.resource.data.weekMinutes is number
                     && request.resource.data.weekMinutes >= 0
                     && request.resource.data.weekPomodoros is number
                     && request.resource.data.weekPomodoros >= 0;
      }
    }
  }
}
